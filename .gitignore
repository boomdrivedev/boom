# Each entry is negated among root:format's inputs (moon.yml), so moon
# hashes nothing git ignores: an entry added here is added there.

.devenv/
.devenv.flake.nix
devenv.local.nix
.pre-commit-config.yaml
.moon/cache/
/result
.DS_Store

# cargo's build directory
/target

# The store's last entry, which root:terms-head writes for root:terms
/.boom-terms/

# The site's dependencies, build and screenshots (site/README.md)
/site/node_modules/
/site/dist/
/site/.astro/
/site/shots/
